# =========================================================================
#  systemd unit — roda a app Flask com Gunicorn atrás do Nginx.
#  Instale em: /etc/systemd/system/projeto-seguro.service
#  Depois:  sudo systemctl daemon-reload && sudo systemctl enable --now projeto-seguro
# =========================================================================
[Unit]
Description=Projeto Seguro (Flask + Gunicorn)
After=network.target

[Service]
# Usuário sem privilégios (nunca rode a app como root — least privilege).
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/projeto-seguro
# Carrega segredos do arquivo de ambiente (fora do Git, permissões 600).
EnvironmentFile=/home/deploy/projeto-seguro/.env
ExecStart=/home/deploy/projeto-seguro/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    app:app
Restart=always
RestartSec=3

# Endurecimento do serviço (Secure by Default)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
