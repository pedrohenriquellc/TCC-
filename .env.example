# =========================================================================
#  ARQUIVO DE EXEMPLO — copie para .env e preencha com valores reais.
#  O .env real NUNCA vai para o Git (bloqueado no .gitignore).
# =========================================================================

# Chave secreta do Flask (assina cookies de sessão).
# Gere uma forte com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-hex

# Usuário e senha de demonstração do protótipo.
DEMO_USER=admin
DEMO_PASSWORD=troque-esta-senha

# Deixe FLASK_DEBUG desligado em produção (Secure by Default).
FLASK_DEBUG=0
